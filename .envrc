watch_file flake.nix
watch_file flake.lock
watch_file pyproject.toml
watch_file uv.lock

# Nix on itx uses nix-portable; its /nix/store paths cannot be exported to
# the host shell. Let nix develop sync the portable Python environment,
# then activate only that virtualenv in the host shell.
if ! nix develop . --command true; then
    return 1
fi
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"
